{
  "name": "omp-provider-kiro",
  "version": "0.3.0",
  "description": "OMP-native provider extension for Kiro API",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajdiyassin/omp-extension-kiro.git"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "kiro",
    "aws",
    "codewhisperer",
    "provider",
    "extension"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=bundle",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe:models": "esbuild scripts/probe-list-models.ts --bundle --platform=node --format=esm --outfile=scripts/probe-list-models.mjs --packages=bundle && node scripts/probe-list-models.mjs",
    "probe:phase0:refresh": "bun scripts/probe-phase0-refresh.ts",
    "probe:phase0:exception": "bun scripts/probe-phase0-exception.ts",
    "prepack": "npm run check && npm test && npm run build",
    "prepublishOnly": "npm run check && npm run test && npm run build"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^1.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@oh-my-pi/pi-ai": "17.2.5",
    "@oh-my-pi/pi-coding-agent": "17.2.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
